generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String     @id @default(uuid()) @db.Uuid
  roles UserRole[] @default([RENTER])
  email String     @unique
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propManagerProfile PropManagerProfile?
  renterProfile      RenterProfile?

  @@map("users")
}

model PropManagerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verified Boolean @default(false)

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prop_manager_profiles")
}

model RenterProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("renter_profiles")
}

/////////////////////////////////////////////////
// LISTINGS
/////////////////////////////////////////////////

model Listing {
  id            String             @id @default(uuid())
  propManagerId String             @db.Uuid
  propManager   PropManagerProfile @relation(fields: [propManagerId], references: [id])
  title         String
  status        ListingStatus      @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Location — core fields required; enrichment optional
  address          String
  apartmentUnit    String?
  city             String
  zip              String
  neighborhood     String?
  latitude         Float   @default(0)
  longitude        Float   @default(0)
  distanceToCampus Float?
  hideExactAddress Boolean @default(false)

  // Pricing
  monthlyRent       Int
  deposit           Int?
  applicationFee    Int?
  utilitiesIncluded Boolean   @default(false)
  leaseType         LeaseType
  moveInDate        DateTime?
  moveOutDate       DateTime?

  // Room info
  numberOfRooms Int
  roomType      RoomType
  bathroomType  BathroomType
  roommateCount Int          @default(0)

  // Requirements — maxOccupants required; screening details optional
  roommatesAllowed   Boolean @default(false)
  maxOccupants       Int
  incomeRequirement  Int?
  creditScoreMinimum Int?
  backgroundCheck    Boolean @default(false)
  petsAllowed        Boolean @default(false)
  smokingAllowed     Boolean @default(false)
  quietHours         String?

  // Amenities — all optional toggles, default false
  furnished     Boolean @default(false)
  laundry       Boolean @default(false)
  parking       Boolean @default(false)
  wifiIncluded  Boolean @default(false)
  gasIncluded   Boolean @default(false)
  waterIncluded Boolean @default(false)

  photos Photo[]

  @@index([propManagerId])
  @@index([status])
  @@index([city])
  @@index([monthlyRent])
  @@map("listings")
}

/////////////////////////////////////////////////
// PHOTOS
/////////////////////////////////////////////////

model Photo {
  id         String  @id @default(uuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl   String
  orderIndex Int
  isCover    Boolean @default(false)
}

/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeaseType {
  MONTH_TO_MONTH
  SIX_MONTH
  TWELVE_MONTH
  CUSTOM
}

enum RoomType {
  PRIVATE
  SHARED
}

enum BathroomType {
  PRIVATE
  SHARED
}

enum UserRole {
  PROPMANAGER
  RENTER
}
