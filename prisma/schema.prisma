// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
	id    Int     @id @default(autoincrement()) 
	address String 
	dateCreated DateTime
	location Json
	leaseType LeaseType
	
}

enum LeaseType{
	MTM
	M6
	M12
	CUSTOM
}


