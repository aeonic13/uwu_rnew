# App Configuration
VITE_APP_NAME=Rentra
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:3000

# API Configuration
# Development
VITE_API_URL=http://localhost:5001/api
# Production
# VITE_API_URL=https://api.myrentra.com/api
VITE_API_TIMEOUT=30000

# Authentication (Future Implementation)
# VITE_AUTH_DOMAIN=your-auth-domain.com
# VITE_AUTH_CLIENT_ID=your-client-id
# VITE_AUTH0_AUDIENCE=your-api-audience

# Payment Integration (Future - Stripe)
# VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Analytics (Optional)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://your-sentry-dsn

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Feature Flags
VITE_ENABLE_MESSAGING=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_OWNER_VERIFICATION=true
VITE_ENABLE_RATE_LIMITING=true

# University Email Validation
VITE_REQUIRE_EDU_EMAIL=true
VITE_ALLOWED_EMAIL_DOMAINS=.edu

# Rate Limiting
VITE_RATE_LIMIT_LOGIN=5
VITE_RATE_LIMIT_MESSAGE=20
VITE_RATE_LIMIT_APPLICATION=3
VITE_RATE_LIMIT_WINDOW=900000

# Development Tools
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug
