// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User types
enum UserType {
  student
  owner
  cosigner
}

// Cosigner status
enum CosignerStatus {
  pending
  accepted
  declined
}

// Application status
enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

// Transaction status
enum TransactionStatus {
  pending
  processing
  completed
  failed
  refunded
}

// Property types
enum PropertyType {
  Apartment
  House
  Studio
  SingleRoom
  Condo
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  userType      UserType
  firstName     String
  lastName      String
  phone         String?
  university    String?
  major         String?
  year          String?
  bio           String?
  avatarUrl     String?
  instagramUrl  String?
  linkedinUrl   String?
  creditScore   Int?
  creditTier    String?
  backgroundCheck String?
  verified      Boolean   @default(false)
  verifyToken   String?
  verifyTokenExp DateTime?
  // Plaid item access token, held server-side only (never sent to the
  // client). TODO: encrypt at rest with a KMS-managed key before GA.
  plaidAccessToken String?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  listings            Listing[]
  sentApplications    Application[]       @relation("ApplicantApplications")
  receivedApplications Application[]      @relation("OwnerApplications")
  sentMessages        Message[]           @relation("SentMessages")
  conversationUsers   ConversationUser[]
  transactions        Transaction[]
  favorites           Favorite[]
  reviews             Review[]            @relation("ReviewAuthor")
  receivedReviews     Review[]            @relation("ReviewSubject")
  cosignedApplications Cosigner[]         @relation("CosignerUser")
  cosignersForTenant  Cosigner[]          @relation("TenantUser")
  housemateProfile    HousemateProfile?
  maintenanceTickets  MaintenanceTicket[] @relation("TenantTickets")
  createdGroups       Group[]             @relation("GroupCreator")
  groupMemberships    GroupMember[]
  groupMessages       GroupMessage[]      @relation("GroupMessages")
  utilityBills        UtilityBill[]       @relation("UtilityBills")
  utilityShares       UtilityBillShare[]  @relation("UtilityShares")

  @@index([email])
  @@index([userType])
}

// Listing model
model Listing {
  id           String       @id @default(cuid())
  title        String
  description  String
  price        Int
  location     String
  university   String?
  moveInDate   DateTime?
  moveOutDate  DateTime?
  propertyType PropertyType
  bedrooms     Int          @default(0)
  bathrooms    Float        @default(1)
  incomeMultiplier Float    @default(3)
  amenities    String[]
  images       String[]
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  ownerId       String
  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications  Application[]
  conversations Conversation[]
  favorites     Favorite[]
  reviews       Review[]
  maintenanceTickets MaintenanceTicket[]

  @@index([ownerId])
  @@index([university])
  @@index([price])
  @@index([active])
}

// Roommate group - students teaming up to apply together
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  maxMembers  Int      @default(4)
  status      String   @default("active") // active, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  messages    GroupMessage[]

  @@index([createdById])
}

// Group chat message
model GroupMessage {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("text") // text, listing
  metadata  Json?
  createdAt DateTime @default(now())

  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("GroupMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdAt])
}

// Group membership (active members + pending email invites)
model GroupMember {
  id          String   @id @default(cuid())
  role        String   @default("member") // admin, member
  status      String   @default("active") // active, invited
  inviteEmail String?
  joinedAt    DateTime @default(now())

  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

// Utility bill split among roommates
model UtilityBill {
  id          String    @id @default(cuid())
  utilityType String
  provider    String?
  dueDate     DateTime?
  total       Float
  splitMode   String    @default("equal") // equal, custom
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User               @relation("UtilityBills", fields: [createdById], references: [id], onDelete: Cascade)
  shares      UtilityBillShare[]

  @@index([createdById])
}

// One person's share of a utility bill
model UtilityBillShare {
  id     String  @id @default(cuid())
  name   String
  amount Float
  paid   Boolean @default(false)

  billId String
  bill   UtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId String?
  user   User?       @relation("UtilityShares", fields: [userId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([userId])
}

// Maintenance ticket - tenant-reported issue for a leased property
model MaintenanceTicket {
  id          String    @id @default(cuid())
  category    String
  description String
  priority    String    @default("medium") // low, medium, high
  status      String    @default("pending") // pending, in-progress, completed
  photos      String[]  @default([])
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId  String
  tenant    User    @relation("TenantTickets", fields: [tenantId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId])
  @@index([status])
}

// Favorite (saved properties)
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

// Application model
model Application {
  id               String            @id @default(cuid())
  status           ApplicationStatus @default(pending)
  message          String?
  startDate        DateTime
  endDate          DateTime
  emergencyContact String?
  employmentStatus String?
  references       String[]          @default([])
  documents        String[]          @default([])
  tourStatus       String            @default("not-requested")
  tourDate         DateTime?
  verificationData Json?             // Stores Plaid income, identity, fee results
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User          @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User          @relation("OwnerApplications", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  agreement    Agreement?
  cosigners    Cosigner[]

  @@index([listingId])
  @@index([applicantId])
  @@index([ownerId])
  @@index([status])
}

// Agreement/Contract model
model Agreement {
  id               String   @id @default(cuid())
  monthlyRent      Int
  securityDeposit  Int
  startDate        DateTime
  endDate          DateTime
  terms            Json     // Additional terms stored as JSON
  tenantSigned     Boolean  @default(false)
  tenantSignedAt   DateTime?
  landlordSigned   Boolean  @default(false)
  landlordSignedAt DateTime?
  documentUrl      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// Conversation model
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listingId String?
  listing   Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  users     ConversationUser[]
  messages  Message[]

  @@index([listingId])
}

// Many-to-many relation for conversation participants
model ConversationUser {
  id           String   @id @default(cuid())
  unreadCount  Int      @default(0)
  lastReadAt   DateTime?
  joinedAt     DateTime @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

// Message model
model Message {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("text") // text, image, tour-request, tour-response
  metadata  Json?    // Additional data for special message types
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// Transaction model
model Transaction {
  id            String            @id @default(cuid())
  amount        Int
  serviceFee    Int
  total         Int
  status        TransactionStatus @default(pending)
  paymentMethod String?
  stripeId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: pre-application charges (e.g. the application fee at
  // pre-qualification) have no application yet.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([status])
}

// Review model
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User    @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([subjectId])
  @@index([listingId])
}

// Housemate compatibility profile - powers the people-first Housemates tab.
// Stores how a user actually lives so we can compute a Compatibility Score
// between any two users before they message each other.
model HousemateProfile {
  id             String   @id @default(cuid())
  // Lifestyle answers (kept as simple strings so the quiz can evolve freely).
  // Weights in server/utils/compatibility.js reflect roommate-conflict
  // research: cleanliness is the #1 friction source, then noise/sleep,
  // then guests; smoking/pets act as near-dealbreakers.
  sleepSchedule  String?  // morning, night
  cleanliness    String?  // very, relaxed
  noiseTolerance String?  // quiet, lively
  guestFrequency String?  // rarely, sometimes, often
  smoking        String?  // no, outdoor, yes
  pets           String?  // love, okay, none
  socialStyle    String?  // friends, friendly, private
  sharing        String?  // share, ask, separate
  chores         String?  // schedule, flexible
  conflictStyle  String?  // direct, gentle
  // Discovery / display fields
  audience       String?  // professional, student, parent, remote, retiree
  occupation     String?
  location       String?
  budgetMin      Int?
  budgetMax      Int?
  bio            String?
  tags           String[]
  lookingForRoom Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([audience])
  @@index([active])
}

// Cosigner model - links cosigners to tenant applications
model Cosigner {
  id               String         @id @default(cuid())
  status           CosignerStatus @default(pending)
  invitedAt        DateTime       @default(now())
  respondedAt      DateTime?
  relationshipType String?        // parent, guardian, relative, friend, etc.

  // Income verification (Plaid) — the guarantor's qualifying income
  verifiedMonthlyIncome Float?
  incomeVerifiedAt      DateTime?

  // Invitation details
  inviteEmail      String
  inviteToken      String         @unique
  tokenExpires     DateTime
  
  // Relations
  applicationId    String
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  tenantId         String
  tenant           User           @relation("TenantUser", fields: [tenantId], references: [id], onDelete: Cascade)
  
  cosignerId       String?
  cosigner         User?          @relation("CosignerUser", fields: [cosignerId], references: [id], onDelete: SetNull)
  
  @@index([applicationId])
  @@index([tenantId])
  @@index([cosignerId])
  @@index([inviteToken])
  @@index([status])
}
