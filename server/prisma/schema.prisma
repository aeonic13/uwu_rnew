// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User types
enum UserType {
  student
  owner
  cosigner
}

// Cosigner status
enum CosignerStatus {
  pending
  accepted
  declined
}

// Application status
enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

// How an Application row came to exist. `applied` is the marketplace funnel;
// `onboarded` is a member row the landlord created when importing an
// existing household (see TenantInvite). Screens that mean "people who
// applied" filter on `applied`.
enum ApplicationSource {
  applied
  onboarded
}

// Where a lease was executed. `rentra` leases are e-signed here; `imported`
// leases were signed off-platform and each tenant only confirms the terms.
enum AgreementSource {
  rentra
  imported
}

enum TenantInviteStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

// Transaction status
enum TransactionStatus {
  pending
  processing
  completed
  failed
  refunded
}

// Property types
enum PropertyType {
  Apartment
  House
  Studio
  SingleRoom
  Condo
}

// User model
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  userType         UserType
  firstName        String
  lastName         String
  phone            String?
  university       String?
  major            String?
  year             String?
  bio              String?
  avatarUrl        String?
  instagramUrl     String?
  linkedinUrl      String?
  creditScore      Int?
  creditTier       String?
  backgroundCheck  String?
  verified         Boolean   @default(false)
  verifyToken      String?
  verifyTokenExp   DateTime?
  // Plaid item access token, held server-side only (never sent to the
  // client). TODO: encrypt at rest with a KMS-managed key before GA.
  plaidAccessToken String?
  // Universal rental application answers (residence history, employment,
  // references, disclosures) filled once at pre-qualification and reused
  // to prefill every property application. Deliberately excludes SSN/DOB.
  rentalProfile    Json?
  resetToken       String?
  resetTokenExp    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  listings              Listing[]
  sentApplications      Application[]       @relation("ApplicantApplications")
  receivedApplications  Application[]       @relation("OwnerApplications")
  sentMessages          Message[]           @relation("SentMessages")
  conversationUsers     ConversationUser[]
  transactions          Transaction[]
  favorites             Favorite[]
  reviews               Review[]            @relation("ReviewAuthor")
  receivedReviews       Review[]            @relation("ReviewSubject")
  cosignedApplications  Cosigner[]          @relation("CosignerUser")
  cosignersForTenant    Cosigner[]          @relation("TenantUser")
  housemateProfile      HousemateProfile?
  maintenanceTickets    MaintenanceTicket[] @relation("TenantTickets")
  createdGroups         Group[]             @relation("GroupCreator")
  groupMemberships      GroupMember[]
  groupMessages         GroupMessage[]      @relation("GroupMessages")
  utilityBills          UtilityBill[]       @relation("UtilityBills")
  utilityShares         UtilityBillShare[]  @relation("UtilityShares")
  rentSplits            RentSplit[]         @relation("RentSplitCreator")
  rentSplitShares       RentSplitShare[]    @relation("RentSplitShares")
  autopaySchedules      AutopaySchedule[]
  policyAcceptances     PolicyAcceptance[]
  agreementSignatures   AgreementSigner[]   @relation("AgreementSignatures")
  screeningReports      ScreeningReport[]
  securityDeposits      SecurityDeposit[]   @relation("OwnerDeposits")
  expenses              Expense[]
  documents             Document[]
  savedSearches         SavedSearch[]
  tenantInvitesSent     TenantInvite[]      @relation("TenantInvitesSent")
  tenantInvitesAccepted TenantInvite[]      @relation("TenantInvitesAccepted")
  blocksGiven           UserBlock[]         @relation("BlocksGiven")
  blocksReceived        UserBlock[]         @relation("BlocksReceived")
  reportsFiled          UserReport[]        @relation("ReportsFiled")
  reportsReceived       UserReport[]        @relation("ReportsReceived")

  @@index([email])
  @@index([userType])
}

// Saved search — a tenant's standing search. When a new listing matches, we
// email them, which turns a one-off visit into a standing relationship (the
// main mitigation for a thin marketplace).
model SavedSearch {
  id           String   @id @default(cuid())
  // Filter snapshot; all optional. location is substring-matched against
  // the listing's location and university fields, case-insensitively.
  location     String?
  minPrice     Int?
  maxPrice     Int?
  minBeds      Int?
  propertyType String?
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Listing model
model Listing {
  id                String       @id @default(cuid())
  title             String
  description       String
  price             Int
  // Public locality shown on cards ("Pacific Beach, San Diego, CA 92109").
  location          String
  // Exact street address (optional). Geocoded on save; coordinates feed the
  // Browse map. Listings without one are pinned at their neighborhood center.
  streetAddress     String?
  latitude          Float?
  longitude         Float?
  university        String?
  moveInDate        DateTime?
  moveOutDate       DateTime?
  propertyType      PropertyType
  bedrooms          Int          @default(0)
  bathrooms         Float        @default(1)
  incomeMultiplier  Float        @default(3)
  // Screening criteria stated up front so applicants see them before paying
  // (CA AB 2493 first-qualified-applicant path). Free-form JSON, e.g.
  // { minIncomeMultiple: 3, minCreditScore: 650, acceptsVouchers: true }.
  screeningCriteria Json?
  amenities         String[]
  images            String[]
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications       Application[]
  conversations      Conversation[]
  favorites          Favorite[]
  reviews            Review[]
  maintenanceTickets MaintenanceTicket[]
  expenses           Expense[]
  documents          Document[]          @relation("ListingDocuments")
  tenantInvites      TenantInvite[]

  @@index([ownerId])
  @@index([university])
  @@index([price])
  @@index([active])
  @@index([latitude, longitude])
}

// Roommate group - students teaming up to apply together
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  maxMembers  Int      @default(4)
  status      String   @default("active") // active, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById  String
  createdBy    User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members      GroupMember[]
  messages     GroupMessage[]
  applications Application[]

  @@index([createdById])
}

// Group chat message
model GroupMessage {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("text") // text, listing
  metadata  Json?
  createdAt DateTime @default(now())

  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation("GroupMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdAt])
}

// Group membership (active members + pending email invites)
model GroupMember {
  id          String   @id @default(cuid())
  role        String   @default("member") // admin, member
  status      String   @default("active") // active, invited
  inviteEmail String?
  joinedAt    DateTime @default(now())

  groupId String
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

// Utility bill split among roommates. The creator is the person who pays
// the provider; every other share is money owed back to them. The uploaded
// bill (PDF/image) is kept on Cloudinary so the household has one place to
// find it.
model UtilityBill {
  id          String    @id @default(cuid())
  utilityType String
  provider    String?
  dueDate     DateTime?
  total       Float
  splitMode   String    @default("equal") // equal, custom
  // Billing month (YYYY-MM) used to consolidate bills into a monthly view.
  period      String?
  notes       String?
  fileUrl     String?
  fileName    String?
  mimeType    String?
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User               @relation("UtilityBills", fields: [createdById], references: [id], onDelete: Cascade)
  shares      UtilityBillShare[]

  @@index([createdById])
  @@index([period])
}

// One person's share of a utility bill
model UtilityBillShare {
  id     String    @id @default(cuid())
  name   String
  amount Float
  paid   Boolean   @default(false)
  paidAt DateTime?

  billId String
  bill   UtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId String?
  user   User?       @relation("UtilityShares", fields: [userId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([userId])
}

// Maintenance ticket - tenant-reported issue for a leased property
model MaintenanceTicket {
  id          String    @id @default(cuid())
  category    String
  description String
  priority    String    @default("medium") // low, medium, high
  status      String    @default("pending") // pending, in-progress, completed
  photos      String[]  @default([])
  assignedTo  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId  String
  tenant    User    @relation("TenantTickets", fields: [tenantId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId])
  @@index([status])
}

// Favorite (saved properties)
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

// Application model
model Application {
  id               String            @id @default(cuid())
  status           ApplicationStatus @default(pending)
  message          String?
  startDate        DateTime
  endDate          DateTime
  emergencyContact String?
  employmentStatus String?
  references       String[]          @default([])
  documents        String[]          @default([])
  tourStatus       String            @default("not-requested")
  tourDate         DateTime?
  verificationData Json? // Stores Plaid income, identity, fee results
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  listingId         String
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Null only for an `onboarded` member row whose tenant has not accepted
  // their invite yet; set on acceptance. Anything that joins `applicant`
  // must tolerate null or filter `applicantId: { not: null }`.
  applicantId       String?
  applicant         User?             @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User              @relation("OwnerApplications", fields: [ownerId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  // The household lease this application is a party to. Every member of a
  // group application points at the same Agreement; the Agreement's own
  // applicationId is just the lead application it was created from.
  agreementId       String?
  agreement         Agreement?        @relation("LeaseMembers", fields: [agreementId], references: [id], onDelete: SetNull)
  leadOf            Agreement?        @relation("LeadApplication")
  cosigners         Cosigner[]
  source            ApplicationSource @default(applied)
  // The invite that fills this member row (onboarded rows only).
  tenantInvite      TenantInvite?
  // Set when this application was submitted as part of a roommate group —
  // one Application row per member, linked by the shared groupId.
  groupId           String?
  group             Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // The reusable screening report backing this application. Instead of
  // re-verifying per application, we link the applicant's still-valid report
  // (CA AB 2559 "pay once, reuse" — see ScreeningReport).
  screeningReportId String?
  screeningReport   ScreeningReport?  @relation(fields: [screeningReportId], references: [id], onDelete: SetNull)
  // Monthly housing subsidy (e.g. Section 8). Income qualifies against the
  // tenant's share (rent - voucher), never full rent — CA source-of-income law.
  voucherAmount     Int?

  @@index([listingId])
  @@index([applicantId])
  @@index([ownerId])
  @@index([status])
  @@index([groupId])
  @@index([screeningReportId])
  @@index([agreementId])
}

// Agreement/Contract model
model Agreement {
  id               String          @id @default(cuid())
  monthlyRent      Int
  securityDeposit  Int
  startDate        DateTime
  // Month-to-month leases store the next anniversary of startDate here so
  // the column stays meaningful for the rent roll and status math; the UI
  // shows "Month-to-month" instead of the date.
  endDate          DateTime
  monthToMonth     Boolean         @default(false)
  source           AgreementSource @default(rentra)
  terms            Json // Additional terms stored as JSON
  tenantSigned     Boolean         @default(false)
  tenantSignedAt   DateTime?
  landlordSigned   Boolean         @default(false)
  landlordSignedAt DateTime?
  documentUrl      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  // Lead application the lease was created from (solo tenant, or the
  // group member whose approval created the household lease).
  applicationId String            @unique
  application   Application       @relation("LeadApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  // Set for group leases; every member application links back via
  // Application.agreementId and has its own AgreementSigner row.
  groupId       String?
  members       Application[]     @relation("LeaseMembers")
  signers       AgreementSigner[]
  // Compliance record for the deposit money this lease holds (see SecurityDeposit).
  deposit       SecurityDeposit?
  // How the household divides this rent (see RentSplit). Group leases hold
  // one Agreement per member, so the split is looked up across siblings.
  rentSplit     RentSplit?
  autopays      AutopaySchedule[]
  tenantInvites TenantInvite[]
}

// How a household divides monthly rent. One split per lease; for a group
// lease the split lives on whichever member's agreement created it and is
// resolved for the others through the shared application groupId.
model RentSplit {
  id        String   @id @default(cuid())
  total     Float
  splitMode String   @default("equal") // equal, custom
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreementId String           @unique
  agreement   Agreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User             @relation("RentSplitCreator", fields: [createdById], references: [id], onDelete: Cascade)
  shares      RentSplitShare[]

  @@index([createdById])
}

// One person's monthly rent share.
model RentSplitShare {
  id     String @id @default(cuid())
  name   String
  amount Float

  splitId String
  split   RentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?     @relation("RentSplitShares", fields: [userId], references: [id], onDelete: SetNull)

  @@index([splitId])
  @@index([userId])
}

// A tenant's standing instruction to pay their rent share on a day of the
// month. Money movement waits on Moov going live: until then the runner in
// utils/autopay.js sends a reminder on each run day and rolls nextRunAt
// forward, and that runner is where the ACH transfer will be created.
model AutopaySchedule {
  id            String    @id @default(cuid())
  amount        Int // dollars
  dayOfMonth    Int // 1-28
  paymentMethod String    @default("ach")
  status        String    @default("active") // active, paused
  nextRunAt     DateTime
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementId])
  @@index([status, nextRunAt])
}

// Versioned consent trail (see utils/policies.js): terms/privacy at signup,
// screening disclosure before Plaid, e-sign consent with a lease signature,
// autopay authorization. `context` holds action details such as the
// agreementId and typed signature name.
model PolicyAcceptance {
  id         String   @id @default(cuid())
  policy     String // terms | privacy | esign | screening | autopay
  version    String // POLICY_VERSIONS value in force when accepted
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  context    Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, policy])
}

// One signature block on a household lease: every tenant on the lease and
// the landlord. The lease is "signed" only when every row is signed.
// Agreement.tenantSigned / landlordSigned are kept as derived mirrors.
model AgreementSigner {
  id            String    @id @default(cuid())
  role          String // tenant | landlord
  signed        Boolean   @default(false)
  signedAt      DateTime?
  signatureName String?
  createdAt     DateTime  @default(now())

  agreementId   String
  agreement     Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  // Null for an imported lease's tenant block until that tenant accepts
  // their invite; the block is then attached to their account and signed.
  userId        String?
  user          User?     @relation("AgreementSignatures", fields: [userId], references: [id], onDelete: Cascade)
  // The member application this tenant signer came from (null for landlord).
  applicationId String?

  @@unique([agreementId, userId])
  @@index([userId])
}

// A landlord's invitation to a current tenant of an occupied property. The
// landlord records the existing lease (Agreement, source imported) and one
// onboarded Application per tenant; each invite fills one of those member
// rows when the tenant accepts and confirms the lease terms. Mirrors the
// cosigner invite pattern: secret token, expiry, public accept/decline.
model TenantInvite {
  id             String             @id @default(cuid())
  token          String             @unique
  email          String
  firstName      String
  lastName       String
  phone          String?
  status         TenantInviteStatus @default(pending)
  expiresAt      DateTime
  respondedAt    DateTime?
  // When the day-7 reminder went out (utils/tenantInviteRunner.js); reset
  // on resend so the fresh link gets its own reminder.
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  listingId      String
  listing        Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User        @relation("TenantInvitesSent", fields: [ownerId], references: [id], onDelete: Cascade)
  agreementId    String
  agreement      Agreement   @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  // The onboarded member row this invite fills.
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  acceptedUserId String?
  acceptedUser   User?       @relation("TenantInvitesAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([listingId])
  @@index([ownerId])
  @@index([agreementId])
  @@index([status])
}

// Conversation model
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listingId String?
  listing   Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  users     ConversationUser[]
  messages  Message[]

  @@index([listingId])
}

// Many-to-many relation for conversation participants
model ConversationUser {
  id          String    @id @default(cuid())
  unreadCount Int       @default(0)
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

// Message model
model Message {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("text") // text, image, tour-request, tour-response
  metadata  Json? // Additional data for special message types
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// Transaction model
model Transaction {
  id            String            @id @default(cuid())
  amount        Int
  serviceFee    Int
  total         Int
  status        TransactionStatus @default(pending)
  paymentMethod String?
  stripeId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: pre-application charges (e.g. the application fee at
  // pre-qualification) have no application yet.
  applicationId     String?
  application       Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Set when this charge purchased a reusable screening report.
  screeningReportId String?
  screeningReport   ScreeningReport? @relation(fields: [screeningReportId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([status])
  @@index([screeningReportId])
}

// Review model
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([subjectId])
  @@index([listingId])
}

// Housemate compatibility profile - powers the people-first Housemates tab.
// Stores how a user actually lives so we can compute a Compatibility Score
// between any two users before they message each other.
model HousemateProfile {
  id               String   @id @default(cuid())
  // Lifestyle answers (kept as simple strings so the quiz can evolve freely).
  // Weights in server/utils/compatibility.js reflect roommate-conflict
  // research: cleanliness is the #1 friction source, then noise/sleep,
  // then guests; smoking/pets act as near-dealbreakers.
  sleepSchedule    String? // morning, night
  cleanliness      String? // very, relaxed
  noiseTolerance   String? // quiet, lively
  guestFrequency   String? // rarely, sometimes, often
  smoking          String? // no, outdoor, yes
  pets             String? // love, okay, none
  socialStyle      String? // friends, friendly, private
  sharing          String? // share, ask, separate
  chores           String? // schedule, flexible
  conflictStyle    String? // direct, gentle
  // About-you fields used for Hinge-style discovery filtering
  age              Int? // the housemate's own age
  gender           String? // man, woman, nonbinary
  // Desired-roommate preferences (who this person wants to see / be seen by)
  agePreferenceMin Int? // desired roommate minimum age
  agePreferenceMax Int? // desired roommate maximum age
  genderPreference String? // everyone, men, women, nonbinary
  // Discovery / display fields
  audience         String? // professional, student, parent, remote, retiree
  occupation       String?
  // Legacy free-text locality; superseded by city + areas below and kept
  // only as a fallback for profiles saved before the picker existed.
  location         String?
  // Where they want to live: a city plus the neighborhoods they would
  // consider (see utils/areas.js). Empty areas = anywhere in the city.
  city             String?
  areas            String[] @default([])
  // Kept on the profile for display; no longer a discovery filter.
  university       String?
  // When they want to move in: "YYYY-MM" or "flexible".
  moveInMonth      String?
  budgetMin        Int?
  budgetMax        Int?
  bio              String?
  tags             String[]
  lookingForRoom   Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([audience])
  @@index([active])
  @@index([university])
  @@index([city])
}

// User-level block. The blocker and blocked user disappear from each other's
// housemate discovery, and neither can start (or continue) a conversation with
// the other. Blocking is deliberately silent — the blocked user is never told.
model UserBlock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  blockerId String
  blocker   User   @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// User-conduct report filed from a housemate profile (or elsewhere later).
// Kept even if the reporter later blocks or the profile is deleted, so the
// moderation trail survives.
model UserReport {
  id        String   @id @default(cuid())
  reason    String // spam, inappropriate, harassment, fake, other
  details   String?
  status    String   @default("open") // open, reviewed, actioned
  createdAt DateTime @default(now())

  reporterId String
  reporter   User   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User   @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([status])
}

// Cosigner model - links cosigners to tenant applications
model Cosigner {
  id               String         @id @default(cuid())
  status           CosignerStatus @default(pending)
  invitedAt        DateTime       @default(now())
  respondedAt      DateTime?
  relationshipType String? // parent, guardian, relative, friend, etc.

  // Income verification (Plaid) — the guarantor's qualifying income
  verifiedMonthlyIncome Float?
  incomeVerifiedAt      DateTime?

  // Invitation details
  inviteEmail  String
  inviteToken  String   @unique
  tokenExpires DateTime

  // Relations
  // Nullable: a "floating" cosigner invited at pre-qualification has no
  // application yet — it is cloned onto each application the tenant submits.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   User   @relation("TenantUser", fields: [tenantId], references: [id], onDelete: Cascade)

  cosignerId String?
  cosigner   User?   @relation("CosignerUser", fields: [cosignerId], references: [id], onDelete: SetNull)

  // The guarantor's reusable screening report (their income/credit is the real
  // qualifying signal for student tenants). Reused across every application
  // this cosigner backs, until it expires.
  screeningReportId String?
  screeningReport   ScreeningReport? @relation(fields: [screeningReportId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([tenantId])
  @@index([cosignerId])
  @@index([inviteToken])
  @@index([status])
  @@index([screeningReportId])
}

// Reusable/portable screening report — CRA-of-record income + credit.
//
// California-first monetization + compliance model:
//  - Generated by a REGISTERED consumer reporting agency (Plaid Check for
//    income/cash-flow, TransUnion SmartMove for credit/criminal/eviction).
//    That agency carries the FCRA + CA ICRAA duties; Rentra resells and the
//    landlord is the FCRA "end user" — this is what keeps Rentra from being an
//    unregistered CRA.
//  - The tenant pays ONCE and reuses the report across every Rentra listing
//    for the freshness window (CA AB 2559 uses 30 days). One report → many
//    applications is the reuse linkage; expiresAt is the freshness stamp.
//  - consentAt + disclosureVersion capture ICRAA consent taken before the pull;
//    reportUrl is the free copy the applicant is legally entitled to.
model ScreeningReport {
  id     String @id @default(cuid())
  // Owner of the report — a tenant OR a cosigner.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CRA hand-off
  provider         String // "plaid_check" | "transunion" | "checkr"
  externalReportId String? // the CRA's report id (agent of record)
  status           String  @default("pending") // pending | complete | failed

  // Report contents
  verifiedMonthlyIncome Int?
  incomeSource          Json? // breakdown, for voucher / source-of-income handling
  creditScore           Int?
  creditTier            String?
  backgroundResult      Json?

  // Reuse window (CA AB 2559 — 30-day freshness)
  issuedAt  DateTime @default(now())
  expiresAt DateTime

  // CA ICRAA compliance trail
  consentAt         DateTime
  disclosureVersion String
  reportUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reuse linkage: one report → many applications / cosigner records / charges
  applications Application[]
  cosigners    Cosigner[]
  transactions Transaction[]

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

// Security-deposit compliance record — one per signed lease. Tracks the money
// held, the state-law refund clock (CA Civ. Code 1950.5: itemized statement +
// refund within 21 days of move-out), itemized deductions, and the recorded
// refund. Amounts are whole dollars, matching Agreement.securityDeposit.
model SecurityDeposit {
  id                String    @id @default(cuid())
  amountHeld        Int
  // Two-letter state whose refund rules apply (from the listing; CA-first).
  state             String    @default("CA")
  status            String    @default("holding") // holding, pending_refund, refunded
  moveOutDate       DateTime?
  // moveOutDate + the state's statutory return window; the countdown the UI shows.
  refundDeadline    DateTime?
  refundAmount      Int?
  refundMethod      String? // check, ach, cash, other
  refundedAt        DateTime?
  letterGeneratedAt DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agreementId String             @unique
  agreement   Agreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  // Denormalized from application.ownerId so the owner list is one query.
  ownerId     String
  owner       User               @relation("OwnerDeposits", fields: [ownerId], references: [id], onDelete: Cascade)
  deductions  DepositDeduction[]

  @@index([ownerId])
  @@index([status])
}

// One itemized deduction on a security deposit (statement line item).
model DepositDeduction {
  id           String   @id @default(cuid())
  category     String // unpaid_rent, cleaning, repairs, other
  description  String
  amount       Int
  evidenceUrls String[] @default([])
  createdAt    DateTime @default(now())

  depositId String
  deposit   SecurityDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
}

// Property expense for bookkeeping and the Tax Center. category uses
// Schedule E line names so the tax export needs no mapping table.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  amount      Int
  category    String // advertising, auto_travel, cleaning_maintenance, insurance, legal_professional, management_fees, mortgage_interest, repairs, supplies, taxes, utilities, other
  description String
  vendor      String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([listingId])
  @@index([date])
}

// Stored landlord document (lease, receipt, notice, insurance...). The file
// itself lives in Cloudinary; this row is the searchable index entry.
model Document {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("other") // lease, receipt, notice, insurance, inspection, tax, other
  url       String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation("ListingDocuments", fields: [listingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([listingId])
  @@index([category])
}
