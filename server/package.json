{
  "name": "rentra-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API server for Rentra",
  "main": "index.js",
  "scripts": {
    "start": "dotenvx run -- node index.js",
    "dev": "dotenvx run -- nodemon index.js",
    "test": "dotenvx run -- vitest",
    "test:coverage": "dotenvx run -- vitest --coverage",
    "db:seed": "dotenvx run -- node prisma/seed.js",
    "db:reset": "dotenvx run -- prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "api",
    "rentalting"
  ],
  "author": "Rentra Team",
  "license": "MIT",
  "dependencies": {
    "@moovio/node": "^1.2.2",
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.2",
    "plaid": "^41.3.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.0.0",
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "supertest": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
