{
  "name": "rentra-app",
  "version": "1.0.0",
  "type": "module",
  "description": "A mobile-first React app for student rentalting",
  "main": "src/index.js",
  "scripts": {
    "dev": "dotenvx run -- vite",
    "start": "dotenvx run -- vite",
    "build": "dotenvx run -- vite build",
    "preview": "dotenvx run -- vite preview",
    "test": "dotenvx run -- vitest",
    "test:ui": "dotenvx run -- vitest --ui",
    "test:coverage": "dotenvx run -- vitest --coverage",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "server/**/*.js": [
      "eslint --fix --config server/eslint.config.js",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.263.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plaid-link": "^4.1.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.75.1",
    "@eslint/js": "^9.38.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.27",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "react",
    "rentalting",
    "student-housing",
    "mobile-app"
  ],
  "author": "Rentra Team",
  "license": "MIT"
}
